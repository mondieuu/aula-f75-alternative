{
  "name": "aula-f75-alternative",
  "productName": "AULA F75",
  "version": "1.3.0",
  "description": "Lightweight open-source alternative app for the AULA F75 keyboard: lighting, key remapping, knob modes, battery and firmware tools over WebHID",
  "main": "app/main.js",
  "private": true,
  "license": "MIT",
  "author": "mondieuu",
  "repository": { "type": "git", "url": "https://github.com/mondieuu/aula-f75-alternative.git" },
  "keywords": ["aula", "f75", "keyboard", "webhid", "sinowealth", "rgb", "electron"],
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "aula-f75-web",
    "productName": "AULA F75",
    "files": [
      "app/**/*",
      "*.js",
      "index.html",
      "style.css",
      "package.json"
    ],
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "app/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "artifactName": "AULA-F75-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mondieuu",
        "repo": "aula-f75-alternative"
      }
    ]
  }
}
